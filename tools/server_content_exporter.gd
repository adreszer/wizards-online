class_name ServerContentExporter
extends RefCounted
## Builds the server's copies of client-side content lists as Lua modules
## (`nakama/modules/generated/*.lua`), so the Nakama runtime never keeps a
## hand-written mirror. Run `tools/export_server_content.gd` to write them;
## `tests/run_tests.tscn` fails when a written file differs from what this
## class would produce now.

const OUT_DIR := "res://nakama/modules/generated/"
const HEADER := "-- GENERATED by tools/export_server_content.gd from %s; do not edit.\n"
const CASTLE_SCENE := "res://levels/castle/castle.tscn"
## Exported object settings the server's object rules read (when the script has them).
const RULE_SETTINGS: Array[String] = ["state_count", "initial_state", "toggleable", "lit", "relight_after", "one_shot", "locked", "start_open", "item_id"]


## File name → Lua source, for every generated module.
static func build_all() -> Dictionary:
	return {
		"spells.lua": _module("resources/spells (SpellRegistry)", _spells()),
		"items.lua": _module("resources/items (ItemRegistry)", _items()),
		"sorting.lua": _module("resources/school/sorting.tres (HouseSorting)", _sorting()),
		"characters.lua": _module("characters/character_registry.gd", _characters()),
		"subjects.lua": _module("resources/school/subjects (SubjectRegistry)", _subjects()),
		"protocol.lua": _module("multiplayer/network_protocol.gd", _protocol()),
		"world_objects.lua": _module("levels/castle/castle.tscn (world_objects group)", world_objects(CASTLE_SCENE)),
	}


## Writes every module; returns the names of files whose content changed.
static func write_all() -> PackedStringArray:
	var changed := PackedStringArray()
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	var modules := build_all()
	for file_name: String in modules:
		var path := OUT_DIR + file_name
		if FileAccess.file_exists(path) and FileAccess.get_file_as_string(path) == modules[file_name]:
			continue
		var f := FileAccess.open(path, FileAccess.WRITE)
		if f == null:
			push_error("cannot write %s" % path)
			continue
		f.store_string(modules[file_name])
		f.close()
		changed.append(file_name)
	return changed


## Module names whose file on disk is missing or differs from a fresh export.
static func stale() -> PackedStringArray:
	var out := PackedStringArray()
	var modules := build_all()
	for file_name: String in modules:
		var path := OUT_DIR + file_name
		if not FileAccess.file_exists(path) or FileAccess.get_file_as_string(path) != modules[file_name]:
			out.append(file_name)
	return out


static func _spells() -> Dictionary:
	var by_id := {}
	for def in SpellRegistry.all():
		var subject := SubjectRegistry.for_spell(str(def.id))
		by_id[str(def.id)] = {
			"subject": str(subject.id) if subject != null else "",
			"effect_type": str(def.effect_type),
			"cooldown": def.cooldown,
			"range": def.range,
			"strength": def.strength,
		}
	return {"ids": SpellRegistry.SPELL_IDS.duplicate(), "by_id": by_id}


static func _items() -> Dictionary:
	var by_id := {}
	for id in ItemRegistry.ITEM_IDS:
		var def := ItemRegistry.load_definition(id)
		if def == null:
			continue
		by_id[id] = {"holdable": def.holdable, "max_stack": def.max_stack, "burn_seconds": def.burn_seconds, "mount": def.is_mount()}
	return {"ids": ItemRegistry.ITEM_IDS.duplicate(), "by_id": by_id, "starting": ItemRegistry.STARTING_ITEMS.duplicate(true)}


static func _sorting() -> Dictionary:
	# Per question: answer index (1-based in Lua) → house.
	var questions: Array = []
	for q: Dictionary in HouseSorting.questions():
		var houses: Array = []
		for a: Dictionary in q["answers"]:
			houses.append(int(a["house"]))
		questions.append(houses)
	return {"questions": questions}


static func _subjects() -> Dictionary:
	var by_id := {}
	var by_area := {}
	for def in SubjectRegistry.all():
		by_id[str(def.id)] = {"name_key": def.display_name, "classrooms": Array(def.classrooms), "spells": Array(def.spells())}
		for area in def.classrooms:
			by_area[area] = str(def.id)
	return {"ids": SubjectRegistry.SUBJECT_IDS.duplicate(), "by_id": by_id, "by_area": by_area}


static func _characters() -> Dictionary:
	var ids: Array = CharacterRegistry.CHARACTERS.keys()
	ids.sort()
	return {"ids": ids, "default": CharacterRegistry.DEFAULT, "skin_tones": CharacterLook.SKIN_TONES.size(), "robes": CharacterLook.ROBE_COLORS.size()}


static func _protocol() -> Dictionary:
	var out := {}
	var constants: Dictionary = (NetworkProtocol as Script).get_script_constant_map()
	for name: String in constants:
		if name.begins_with("OP_") or name.begins_with("RPC_") or name in ["CHAT_ROOM", "MAX_CHAT_LENGTH"]:
			out[name] = constants[name]
	return out


## Object id → {kind, area, areas, pos, accepts, <RULE_SETTINGS>} for every node of the
## scene in the `world_objects` group. `accepts` lists the effect types its
## SpellReceiver takes ("any" = no filter); objects without one accept no spell.
static func world_objects(scene_path: String) -> Dictionary:
	var out := {}
	var scene := load(scene_path) as PackedScene
	if scene == null:
		push_error("cannot load %s" % scene_path)
		return out
	var root := scene.instantiate()
	for node in _descendants(root):
		if not node.is_in_group(&"world_objects"):
			continue
		var oid: String = str(node.get(&"object_id"))
		var kind: Variant = (node.get_script() as Script).get_script_constant_map().get("WORLD_KIND") if node.get_script() else null
		if oid.is_empty() or kind == null:
			push_error("world object %s lacks object_id or WORLD_KIND" % root.get_path_to(node))
			continue
		if out.has(oid):
			push_error("duplicate object id %s" % oid)
		var area := oid.get_slice("/", 0)
		var areas: Array = [area]
		var approach: Variant = node.get(&"approach_area")
		if approach is String and not (approach as String).is_empty():
			areas.append(approach)
		var p := _scene_position(node, root)
		var entry := {"kind": kind, "area": area, "areas": areas, "pos": [snappedf(p.x, 0.01), snappedf(p.y, 0.01), snappedf(p.z, 0.01)], "accepts": _accepted_effects(node)}
		for setting: String in RULE_SETTINGS:
			if setting in node:
				entry[setting] = node.get(setting)
		out[oid] = entry
	root.free()
	return out


static func _descendants(node: Node) -> Array[Node]:
	var out: Array[Node] = []
	for child in node.get_children():
		out.append(child)
		out.append_array(_descendants(child))
	return out


## Position in the scene root's space, without adding the scene to a tree.
static func _scene_position(node: Node, root: Node) -> Vector3:
	var xf := Transform3D.IDENTITY
	var n: Node = node
	while n != null and n != root:
		if n is Node3D:
			xf = (n as Node3D).transform * xf
		n = n.get_parent()
	return xf.origin


static func _accepted_effects(node: Node) -> Array:
	for child in _descendants(node):
		if child is SpellReceiver:
			var types: Array = []
			for t in (child as SpellReceiver).accepted_effect_types:
				types.append(str(t))
			if types.is_empty():
				return ["any"]
			types.sort()
			return types
	return []


static func _module(source: String, value: Variant) -> String:
	return HEADER % source + "return " + lua(value, 0) + "\n"


## Deterministic Lua literal: dictionary keys sorted, arrays as sequences.
static func lua(value: Variant, indent: int) -> String:
	var pad := "  ".repeat(indent + 1)
	var close := "  ".repeat(indent)
	match typeof(value):
		TYPE_NIL:
			return "nil"
		TYPE_BOOL:
			return "true" if value else "false"
		TYPE_INT:
			return str(value)
		TYPE_FLOAT:
			var f: float = value
			return str(int(f)) if f == floorf(f) and absf(f) < 1e15 else String.num(f, 6)
		TYPE_STRING, TYPE_STRING_NAME:
			return _lua_string(str(value))
		TYPE_ARRAY, TYPE_PACKED_STRING_ARRAY, TYPE_PACKED_INT32_ARRAY, TYPE_PACKED_FLOAT32_ARRAY:
			var items: Array = Array(value)
			if items.is_empty():
				return "{}"
			var scalar := items.all(func(v: Variant) -> bool: return typeof(v) not in [TYPE_ARRAY, TYPE_DICTIONARY])
			if scalar:
				var parts := PackedStringArray()
				for v: Variant in items:
					parts.append(lua(v, indent + 1))
				return "{ " + ", ".join(parts) + " }"
			var lines := PackedStringArray()
			for v: Variant in items:
				lines.append(pad + lua(v, indent + 1) + ",")
			return "{\n" + "\n".join(lines) + "\n" + close + "}"
		TYPE_DICTIONARY:
			var d: Dictionary = value
			if d.is_empty():
				return "{}"
			var keys: Array = d.keys()
			keys.sort_custom(func(a: Variant, b: Variant) -> bool: return str(a) < str(b))
			var lines := PackedStringArray()
			for k: Variant in keys:
				lines.append(pad + _lua_key(str(k)) + " = " + lua(d[k], indent + 1) + ",")
			return "{\n" + "\n".join(lines) + "\n" + close + "}"
	push_error("ServerContentExporter: cannot serialize %s" % type_string(typeof(value)))
	return "nil"


static func _lua_key(key: String) -> String:
	var regex := RegEx.create_from_string("^[A-Za-z_][A-Za-z0-9_]*$")
	return key if regex.search(key) != null else "[" + _lua_string(key) + "]"


static func _lua_string(s: String) -> String:
	return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\""
