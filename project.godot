[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="remote_player"
3d_physics/layer_4="spell_target"
3d_physics/layer_5="interactable"
3d_physics/layer_6="trigger"
3d_physics/layer_7="projectile"
3d_physics/layer_8="camera_blocker"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.12, 1)
